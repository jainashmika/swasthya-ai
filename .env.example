# Copy to .env.local for development, and set the same values in the Vercel
# dashboard for production. Never prefix any of these with NEXT_PUBLIC_.

# Required — chat, image analysis and the symptom checker all use this.
OPENAI_API_KEY=sk-...

# Optional — defaults to gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini

# Optional — without it the chatbot still works, but alerts and the activity
# log are disabled. Get one free at https://neon.tech
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Required to use /admin.
ADMIN_PASSWORD=change-me
