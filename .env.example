# ─── AI provider ────────────────────────────────────────────────────────────
# The app speaks the OpenAI chat-completions format, so any compatible
# provider works. Pick ONE block, uncomment it.

# ── Works with no key at all. Good for a first run. ────────────────────────
# A free public gateway. Chat and the symptom checker work immediately.
# Photo analysis does NOT — that model has no vision.
# No uptime guarantee, and no stated policy on what happens to the health
# questions sent through it, so treat it as a demo default and not a place to
# send anything real.
AI_API_KEY=
AI_BASE_URL=https://text.pollinations.ai/openai
AI_MODEL=openai

# ── Google Gemini — FREE, no credit card, and unlocks photo analysis ───────
# Get a key: https://aistudio.google.com/apikey  (sign in, "Create API key")
# Free tier: ~1,500 requests/day. Handles text AND images.
# Note: on the free tier Google may use your inputs to improve their models.
# AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.5-flash

# ── OpenAI — paid, needs billing set up ────────────────────────────────────
# AI_API_KEY=sk-...
# AI_BASE_URL=
# AI_MODEL=gpt-4o-mini

# ── Groq — free tier, very fast, text only (no image analysis) ─────────────
# Get a key: https://console.groq.com/keys
# AI_API_KEY=gsk_...
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile

# ── OpenRouter — free models available, one key for many providers ─────────
# Get a key: https://openrouter.ai/keys
# AI_API_KEY=sk-or-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=google/gemini-2.0-flash-exp:free

# ─── Database (optional) ────────────────────────────────────────────────────
# Enables health alerts and the admin activity log.
# Free Postgres: https://neon.tech  → copy the connection string.
# Leave blank and the chatbot still works; alerts just show as empty.
DATABASE_URL=

# ─── Admin panel ────────────────────────────────────────────────────────────
# The password for /admin. Change this before deploying anywhere.
ADMIN_PASSWORD=change-me
